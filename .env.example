PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost/waleszdesk
ALLOWED_ORIGIN=http://localhost:3001

JWT_SECRET=change-this-to-a-random-64-char-string
ENCRYPTION_KEY=change-this-to-a-random-64-char-string
ADMIN_PASSWORD=change-this-to-a-strong-password-min-20-chars

BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

TRADOVATE_USERNAME=your-tradovate-username
TRADOVATE_PASSWORD=your-tradovate-password
TRADOVATE_IS_DEMO=true
TRADOVATE_CID=your-tradovate-client-id
TRADOVATE_SEC=your-tradovate-client-secret

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@yourdomain.com

REDIS_URL=redis://localhost:6379
